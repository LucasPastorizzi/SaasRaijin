# URL pública do app (usada nos links enviados no WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3333

# Segurança — OBRIGATÓRIOS em produção
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria
ADMIN_EMAIL=admin@raijin.local
ADMIN_PASSWORD=troque-esta-senha

# Banco local (SQLite embutido no Node). Padrão: ./data/raijin.db
# DATABASE_PATH=/caminho/persistente/raijin.db
# SEED_DEMO=0   # não criar clientes/pedidos fictícios no primeiro start

# WhatsApp Business Cloud API (Meta). Sem isso, roda em modo simulação.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=um-texto-qualquer-para-verificar-o-webhook
# WHATSAPP_APP_SECRET=

# E-mail da loja no painel (IMAP para ler, SMTP para enviar). Sem isso, roda em modo simulação.
# Gmail: ative a verificação em 2 etapas e crie uma "senha de app" (não use a senha normal).
# EMAIL_USER=contato@raijinsushi.com.br
# EMAIL_PASSWORD=
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_FROM_NAME=Raijin Sushi

# Assistente de IA do painel (Claude). Crie a chave em console.anthropic.com
ANTHROPIC_API_KEY=

# Gateway de pagamento (Pix/cartão) — integração a implementar (ver README)
# PAYMENT_PROVIDER=mercadopago
# PAYMENT_ACCESS_TOKEN=
